      <a href="https://instagram.com/drivegear.ua" target="_blank" rel="noopener">Instagram</a>
    </nav>
  </div>
</footer>

<script>
const io = new IntersectionObserver((entries) => {
  entries.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
  });
}, { threshold: 0.12 });
document.querySelectorAll('section .grid, section h2, section .lead, .about p, .principles').forEach((el) => {
  el.classList.add('reveal');
  io.observe(el);
});
</script>

</body>
</html>

