<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>DriveGear — Твій автомобіль. Твій порядок.</title>
<style>
:root {
  box-sizing: border-box;
  --bg: #0b0b0c;
  --card: #1a1b1e;
  --text: #f2f2f2;
  --muted: #9a9ca3;
  --accent: #ffc400;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  color-scheme: dark;
}
*, *::before, *::after { box-sizing: border-box; }
html { scroll-padding-top: 70px; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  line-height: 1.5;
}
header {
  position: sticky;
  top: env(safe-area-inset-top, 0px);
  z-index: 10;
  background: rgba(11,11,12,0.92);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid #222;
}
.wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
.nav { display: flex; align-items: center; justify-content: space-between; height: 64px; }
.logo { font-weight: 800; letter-spacing: 1px; font-size: 20px; color: var(--text); text-decoration: none; }
.logo span { color: var(--accent); }
.nav-links { display: flex; gap: 18px; }
.nav-links a { color: var(--muted); text-decoration: none; font-size: 14px; }
.nav-links a:hover { color: var(--text); }

.hero {
  min-height: 80vh;
  display: flex; align-items: center;
  background:
    radial-gradient(circle at 80% 20%, rgba(255,196,0,0.18), transparent 45%),
    linear-gradient(180deg, #0b0b0c, #141518);
  padding: 80px 0;
}
.hero h1 { font-size: clamp(36px, 7vw, 68px); line-height: 1.05; margin: 0 0 18px; font-weight: 800; }
.hero h1 span { color: var(--accent); }
.hero p { color: var(--muted); font-size: 18px; max-width: 520px; margin: 0 0 30px; }
.btn {
  display: inline-block; background: var(--accent); color: #000;
  padding: 16px 28px; border-radius: 10px; font-weight: 700;
  text-decoration: none; letter-spacing: .5px; border: 0; cursor: pointer;
}
.btn:hover { filter: brightness(1.08); }

section { padding: 70px 0; }
h2 { font-size: clamp(26px, 4vw, 36px); margin: 0 0 10px; }
.lead { color: var(--muted); margin: 0 0 32px; max-width: 620px; }

.grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
.card {
  background: var(--card); border: 1px solid #26272b; border-radius: 16px;
  padding: 22px; display: flex; flex-direction: column;
}
.photo { width: 100%; height: 150px; object-fit: cover; border-radius: 12px; margin-bottom: 18px; display: block; }
.thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; display: block; }
.thumb {
  height: 150px; border-radius: 12px; margin-bottom: 18px;
  background: linear-gradient(135deg, #24252a, #101114);
  display: flex; align-items: center; justify-content: center;
  color: var(--accent); font-size: 42px;
}
.photo { width: 100%; height: auto; border-radius: 12px; margin-bottom: 18px; display: block; }
.card h3 { margin: 0 0 8px; font-size: 19px; }
.card p { margin: 0 0 16px; color: var(--muted); font-size: 15px; flex: 1; }
.price-row { display: flex; align-items: center; justify-content: space-between; }
.price { font-weight: 800; font-size: 20px; }
.buy {
  background: transparent; color: var(--accent); border: 1px solid var(--accent);
  padding: 9px 14px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px;
}
.badge {
  display: inline-block; background: var(--accent); color: #000; font-size: 12px;
  font-weight: 800; padding: 4px 10px; border-radius: 999px; margin-bottom: 12px; align-self: flex-start;
}
.trend { border-color: var(--accent); }

.why .grid { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
.why .item { background: var(--card); border-radius: 14px; padding: 20px; }
.why .item strong { display: block; margin-bottom: 6px; color: var(--accent); }
.why .item span { color: var(--muted); font-size: 15px; }

.about { background: #111214; }
.about p { color: var(--muted); max-width: 680px; }
.principles { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 10px; }
.principles li { padding-left: 26px; position: relative; color: var(--text); }
.principles li::before { content: "■"; color: var(--accent); position: absolute; left: 0; font-size: 12px; top: 4px; }

.delivery .grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
.delivery .item { border-top: 2px solid var(--accent); padding-top: 14px; }
.delivery .item h3 { margin: 0 0 6px; font-size: 17px; }
.delivery .item p { color: var(--muted); margin: 0; font-size: 15px; }

footer { border-top: 1px solid #222; padding: 40px 0; background: #070708; }
.foot { display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: flex-start; }
.foot nav { display: flex; flex-wrap: wrap; gap: 16px; }
.foot a { color: var(--muted); text-decoration: none; font-size: 14px; }
.foot a:hover { color: var(--text); }
.copy { color: #5d5f66; font-size: 13px; width: 100%; margin-top: 10px; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes glow {
  0%, 100% { text-shadow: 0 0 0 rgba(255,196,0,0); }
  50% { text-shadow: 0 0 18px rgba(255,196,0,0.45); }
}
.hero h1 { animation: fadeUp .9s ease both; }
.hero h1 span { animation: glow 3s ease-in-out infinite; }
.hero p { animation: fadeUp .9s .15s ease both; }
.hero .btn { animation: fadeUp .9s .3s ease both; }
.reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }
.card { transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease; }
.card:hover { transform: translateY(-6px); border-color: var(--accent); box-shadow: 0 12px 30px rgba(255,196,0,0.12); }
.card:hover .thumb { transform: scale(1.04); }
.thumb { transition: transform .3s ease; }
.buy { transition: background .2s ease, color .2s ease; display: inline-block; text-decoration: none; }
.buy:hover { background: var(--accent); color: #000; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .reveal { opacity: 1; transform: none; }
}

@media (max-width: 640px) {
  .nav-links { gap: 12px; }
  .nav-links a { font-size: 13px; }
  .hero { min-height: auto; padding: 60px 0; }
  section { padding: 50px 0; }
}
</style>
</head>
<body>

